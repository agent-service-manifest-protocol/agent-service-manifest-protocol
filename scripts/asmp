def registry_url() -> str:
    env = os.environ.get("ASMP_REGISTRY_URL")
    if env:
        return env.rstrip("/")
    if HOST_FILE.exists():
        try:
            import yaml

            with HOST_FILE.open() as f:
                host = yaml.safe_load(f) or {}
            api = (host.get("registry") or {}).get("api")
            if api:
                return str(api).rstrip("/")
        except Exception:
            pass
    return DEFAULT_REGISTRY


def request(
    method: str,
    path: str,
    *,
    body: Optional[dict] = None,
    params: Optional[dict[str, str]] = None,
) -> Any:
    base = registry_url()
    url = f"{base}{path}"
    if params:
        qs = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
        if qs:
            url = f"{url}?{qs}"
    data = None
    headers = {"Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read().decode()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode()
        try:
            parsed = json.loads(detail)
            msg = parsed.get("error", detail)
        except json.JSONDecodeError:
            msg = detail or str(e)
        raise SystemExit(f"HTTP {e.code}: {msg}") from e
    except urllib.error.URLError as e:
        raise SystemExit(f"Registry unreachable at {base}: {e.reason}") from e


def load_manifest(path: Path) -> dict:
    if not path.exists():
        raise SystemExit(f"Manifest not found: {path}")
    try:
        import yaml
    except ImportError as e:
        raise SystemExit("pyyaml required: python3 -m pip install --user pyyaml") from e
    with path.open() as f:
        data = yaml.safe_load(f)
    if not isinstance(data, dict):
        raise SystemExit(f"Invalid manifest: {path}")
    return data


def emit(data: Any, *, json_out: bool) -> None:
    if json_out:
        print(json.dumps(data, indent=2, default=str))
        return
    if isinstance(data, dict):
        for key, value in data.items():
            print(f"{key}: {value}")
    elif isinstance(data, list):
        for item in data:
            print(item)
    else:
        print(data)


def _ambient_disabled(prompt: str = "") -> tuple[bool, str]:
    setting = os.environ.get("ASMP_AMBIENT", "").strip().lower()
    if setting in {"0", "false", "off", "no", "disabled"}:
        return True, "ASMP_AMBIENT disables ambient context"
    low = prompt.lower()
    for phrase in AMBIENT_DISABLE_PHRASES:
        if phrase in low:
            return True, f"user override: {phrase}"
    return False, ""


def _ambient_prompt_matches(prompt: str) -> bool:
    low = prompt.lower()
    return any(word in low for word in AMBIENT_TRIGGER_WORDS + ORACLE_TRIGGER_WORDS)


def _redact_text(value: str) -> str:
    out = value
    out = re.sub(r"(?i)\b(bearer|token|api[-_ ]?key)\s+[-A-Za-z0-9._~+/=]+", r"\1 [REDACTED]", out)
    out = re.sub(
        r"(?i)\b([A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|API_KEY|PRIVATE_KEY|AUTH)[A-Z0-9_]*=)[^\s&]+",
        r"\1[REDACTED]",
        out,
    )
    out = re.sub(r"://([^:/?#\s]+):([^@/?#\s]+)@", r"://[REDACTED]@", out)
    out = re.sub(
        r"(?i)([?&](?:token|key|api_key|signature|sig|password|secret|auth)=)[^&\s]+",
        r"\1[REDACTED]",
        out,
    )
    return out


def _redact(value: Any) -> Any:
    if isinstance(value, str):
        return _redact_text(value)
    if isinstance(value, list):
        return [_redact(item) for item in value]
    if isinstance(value, dict):
        redacted = {}
        for key, item in value.items():
            if re.search(r"(?i)(token|secret|password|private|cookie|auth|credential)", str(key)):
                redacted[key] = "[REDACTED]"
            else:
                redacted[key] = _redact(item)
        return redacted
    return value


def _tokens(text: str) -> set[str]:
    return set(re.findall(r"[a-z0-9]+", (text or "").lower()))


def _meaningful_tokens(text: str) -> set[str]:
    stop = {
        "a",
        "an",
        "and",
        "are",
        "do",
        "does",
        "for",
        "from",
        "in",
        "it",
        "of",
        "or",
        "the",
        "this",
        "to",
        "with",
    }
    return {token for token in _tokens(text) if len(token) >= 3 and token not in stop}


def _phrase_overlap_score(prompt: str, phrase: str) -> float:
    phrase_tokens = _meaningful_tokens(phrase)
    if not phrase_tokens:
        return 0.0
    prompt_tokens = _meaningful_tokens(prompt)
    return len(prompt_tokens & phrase_tokens) / len(phrase_tokens)


def _service_text(service: dict) -> str:
    bits: list[str] = []
    for key in ("name", "description", "section", "source", "status", "sync"):
        val = service.get(key)
        if val:
            bits.append(str(val))
    caps = service.get("capabilities") or {}
    for cap_key in ("provides", "owns", "supports", "aliases", "anti_routes"):
        values = service.get(cap_key) or caps.get(cap_key) or []
        if values:
            bits.extend(str(c) for c in values)
    for key in ("positive_examples", "when_not_to_use"):
        values = service.get(key) or []
        bits.extend(str(v) for v in values)
    for item in service.get("negative_examples") or []:
        if isinstance(item, dict):
            bits.extend(str(v) for v in item.values())
        else:
            bits.append(str(item))
    return " ".join(bits).lower()


def _service_positive_text(service: dict) -> str:
    bits: list[str] = []
    for key in ("name", "description", "section", "status", "sync"):
        val = service.get(key)
        if val:
            bits.append(str(val))
    caps = service.get("capabilities") or {}
    for cap_key in ("provides", "owns", "supports", "aliases"):
        values = service.get(cap_key) or caps.get(cap_key) or []
        bits.extend(str(c) for c in values)
    bits.extend(str(v) for v in service.get("positive_examples") or [])
    return " ".join(bits).lower()


def _score_service(prompt: str, service: dict) -> int:
    low = prompt.lower()
    score = 0
    name = str(service.get("name") or "").lower()
    desc = str(service.get("description") or "").lower()
    text = _service_text(service)
    positive_text = _service_positive_text(service)
    if name and name in low:
        score += 100
    for part in re.split(r"[-_\s]+", name):
        if len(part) >= 3 and part in low:
            score += 8
    caps = service.get("capabilities") or {}
    weighted_cap_fields = (
        ("owns", 70),
        ("aliases", 55),
        ("provides", 40),
        ("supports", 25),
    )
    for cap_key, exact_weight in weighted_cap_fields:
        values = service.get(cap_key) or caps.get(cap_key) or []
        for cap in values:
            cap_low = str(cap).lower()
            cap_phrase = cap_low.replace(".", " ").replace("-", " ").replace("_", " ")
            if cap_low and (cap_low in low or cap_phrase in low):
                score += exact_weight
            for part in re.split(r"[-_.\s]+", cap_low):
                if len(part) >= 4 and part in low:
                    score += max(4, exact_weight // 8)
    for example in service.get("positive_examples") or []:
        ex = str(example).lower()
        if ex and ex in low:
            score += 70
        score += int(_phrase_overlap_score(low, ex) * 45)
        for token in _tokens(ex):
            if len(token) >= 4 and token in low:
                score += 4
    for anti in caps.get("anti_routes") or service.get("anti_routes") or []:
        anti_low = str(anti).lower()
        anti_phrase = anti_low.replace(".", " ").replace("-", " ").replace("_", " ")
        if anti_low in low or anti_phrase in low:
            score -= 80
    for item in service.get("negative_examples") or []:
        query = str(item.get("query") if isinstance(item, dict) else item).lower()
        if query and query in low:
            score -= 80
        if _phrase_overlap_score(low, query) >= 0.55:
            score -= 70
    if service.get("routing_role") == "owner":
        score += 12
    elif service.get("routing_role") == "router":
        score -= 10
    prompt_tokens = _meaningful_tokens(low)
    action_boosts = (
        (
            {"test", "qa", "browser", "screenshot", "page", "proof", "validate"},
            {"browser", "screenshot", "ui proof", "page validation", "protected page", "surfari", "rendered dashboard"},
            75,
        ),
        (
            {"ship", "publish", "shipment", "dd5", "supabase", "readback", "parity"},
            {"data ship", "data publication", "supabase", "dd5", "publication batch", "cerebro readback", "batch parity"},
            90,
        ),
        (
            {"deploy", "release", "production", "pr"},
            {"release", "production deploy", "pr release", "deploy cerebro", "ship cerebro"},
            45,
        ),
    )
    for prompt_terms, evidence_terms, boost in action_boosts:
        if prompt_tokens & prompt_terms and any(term in positive_text for term in evidence_terms):
            score += boost
    owns_text = " ".join(str(v).lower() for v in (caps.get("owns") or service.get("owns") or []))
    read_only_test_terms = {"test", "qa", "browser", "screenshot", "page", "validate"}
    release_action_terms = {"ship", "deploy", "release", "publish", "shipment"}
    if (
        prompt_tokens & read_only_test_terms
        and not (prompt_tokens & release_action_terms)
        and any(term in owns_text for term in ("release", "deploy"))
    ):
        score -= 120
    for token in re.findall(r"[a-z0-9][a-z0-9_.-]{2,}", low):
        if token in name:
            score += 5
        elif token in desc:
            score += 2
    for trigger in AMBIENT_TRIGGER_WORDS:
        if trigger in low and trigger in text:
            score += 2
    return score


def _oracle_service_score(question_tokens: set[str], service: dict, role_spec: dict) -> int:
    text = _service_text(service)
    score = 0
    name = str(service.get("name") or "").lower()
    if name:
        for part in re.split(r"[-_.\s]+", name):
            if len(part) >= 3 and part in question_tokens:
                score += 4
    for token in question_tokens:
        if token in text:
            score += 1
    caps = service.get("provides") or (service.get("capabilities") or {}).get("provides") or []
    cap_text = " ".join(str(cap).lower().replace(".", " ") for cap in caps)
    for cap_hint in role_spec.get("capabilities", set()):
        if cap_hint in cap_text or cap_hint in text:
            score += 3
    return score


def _oracle_registry_candidates(question: str) -> tuple[list[dict], str]:
    try:
        services = request("GET", "/services")
    except SystemExit:
        return [], "registry_unavailable"
    if not isinstance(services, list):
        return [], "registry_unexpected_response"
    q_tokens = _tokens(question)
    ranked = []
    for service in services:
        if not isinstance(service, dict):
            continue
        service_score = _score_service(question, service)
        for spec in ORACLE_ROLE_RULES.values():
            service_score += _oracle_service_score(q_tokens, service, spec)
        if service_score > 0:
            ranked.append((service_score, service))
    ranked.sort(key=lambda item: (-item[0], str(item[1].get("name") or "")))
    return [_summarize_service(service) for _score, service in ranked[:6]], "registry_ok"


def _oracle_rank_roles(question: str, candidates: list[dict]) -> list[dict]:
    q_tokens = _tokens(question)
    candidate_text = " ".join(
        " ".join(
            [
                str(candidate.get("name") or ""),
                str(candidate.get("summary") or ""),
                " ".join(str(cap) for cap in candidate.get("provides") or []),
            ]
        ).lower()
        for candidate in candidates
    )
    any_trigger_match = any(q_tokens & spec["triggers"] for spec in ORACLE_ROLE_RULES.values())
    ranked = []
    for role, spec in ORACLE_ROLE_RULES.items():
        trigger_hits = sorted(q_tokens & spec["triggers"])
        service_hits = sorted(token for token in spec["capabilities"] if token in candidate_text)
        if any_trigger_match and not trigger_hits:
            continue
        score = len(trigger_hits) * 2 + len(service_hits)
        if role == "finance" and q_tokens & {"accounting", "ap", "ar", "bill", "books", "expense", "invoice", "payment", "spend"}:
            score += 10
        if role == "security" and q_tokens & {"acceptable", "approve", "decide", "risk"}:
            score += 10
        if score:
            ranked.append(
                {
                    "role": role,
                    "score": score,
                    "trigger_hits": trigger_hits,
                    "service_hits": service_hits,
                }
            )
    ranked.sort(key=lambda item: (-item["score"], item["role"]))
    return ranked


def _oracle_owner_for_role(primary_role: str, candidates: list[dict]) -> str | None:
    spec = ORACLE_ROLE_RULES.get(primary_role)
    if not spec:
        return candidates[0].get("name") if candidates else None
    best = None
    best_score = 0
    empty_tokens: set[str] = set()
    for candidate in candidates:
        score = _oracle_service_score(empty_tokens, candidate, spec)
        text = _service_text(candidate)
        if primary_role in text:
            score += 4
        if score > best_score:
            best = candidate
            best_score = score
    if best:
        return best.get("name")
    return candidates[0].get("name") if candidates else None


def _oracle_question_type(question: str, ranked_roles: list[dict]) -> str:
    q_tokens = _tokens(question)
    if {"should", "approve", "decide", "acceptable"} & q_tokens:
        return "decision"
    if {"prove", "evidence", "find", "determine", "trace", "who", "what", "why"} & q_tokens:
        return "investigative"
    if len(ranked_roles) > 1:
        return "cross_role"
    if ranked_roles:
        return ranked_roles[0]["role"]
    return "ambiguous"


def _oracle_should_invoke(question: str, ranked_roles: list[dict], candidates: list[dict]) -> tuple[bool, list[str]]:
    low = question.lower()
    reasons = []
    if any(trigger in low for trigger in ORACLE_TRIGGER_WORDS):
        reasons.append("oracle_trigger_word")
    if len(ranked_roles) > 1:
        reasons.append("cross_role")
    if not candidates:
        reasons.append("no_asmp_candidates")
    if len(candidates) > 1 and (not ranked_roles or ranked_roles[0]["score"] <= 3):
        reasons.append("multiple_plausible_services")
    if not reasons:
        return False, ["direct_asmp_route_likely_sufficient"]
    return True, reasons


def _oracle_contract(question: str, *, include_registry: bool = True) -> dict:
    candidates: list[dict] = []
    registry_state = "not_queried"
    if include_registry:
        candidates, registry_state = _oracle_registry_candidates(question)
    ranked_roles = _oracle_rank_roles(question, candidates)
    should_invoke, invoke_reasons = _oracle_should_invoke(question, ranked_roles, candidates)
    primary_role = ranked_roles[0]["role"] if ranked_roles else "oracle"
    primary_owner = _oracle_owner_for_role(primary_role, candidates)
    if primary_role == "oracle" or not should_invoke:
        primary_owner = primary_owner or "asmp-router"
    supporting_roles = [role["role"] for role in ranked_roles[1:4]]
    evidence = []
    authorities = []
    for role in ranked_roles[:4]:
        spec = ORACLE_ROLE_RULES[role["role"]]
        evidence.extend(spec["evidence"])
        authorities.append(spec["human_authority"])
    if not evidence:
        evidence = [
            "ASMP registry candidates and manifests",
            "owning service documentation",
            "source-linked ambient context",
        ]
    if not authorities:
        authorities = ["owning human role or Daniel"]
    return {
        "product": "Eidos Oracle",
        "purpose": "Eidos deliberative mission-contract layer powered by ASMP",
        "intent": question.strip(),
        "should_invoke_oracle": should_invoke,
        "invoke_reasons": invoke_reasons,
        "question_type": _oracle_question_type(question, ranked_roles),
        "registry_state": registry_state,
        "primary_owner": primary_owner,
        "role_hypotheses": ranked_roles,
        "supporting_roles": supporting_roles,
        "candidate_services": candidates,
        "human_authority": sorted(set(authorities)),
        "evidence_required": list(dict.fromkeys(evidence)),
        "answer_format": [
            "short answer",
            "primary owner and supporting services",
            "evidence table: source, locator, timestamp, confidence",
            "gaps and next proof",
            "approval boundary before any action",
        ],
        "approval_boundaries": [
            "do not execute the mission from Oracle",
            "do not change production systems, records, access, or credentials",
            "do not contact external parties or send messages",
            "do not retrieve, print, copy, persist, or rotate raw secrets",
        ],
        "confidence_criteria": {
            "high": "direct system-of-record evidence plus corroboration or human owner confirmation",
            "medium": "one strong source with plausible corroborating context",
            "low": "memory, inference, public fingerprint, or uncorroborated ambient context only",
        },
        "memory_update": "After resolution, add aliases, boundary phrases, positive/negative examples, and tests to ASMP or the owning product.",
        "routing_tests": [
            question.strip(),
            "which service should own this question?",
            "what evidence would prove the answer?",
        ],
    }


def _summarize_service(service: dict) -> dict:
    clean = _redact(service)
    cap_map = clean.get("capabilities") or {}
    caps = (
        clean.get("provides")
        or cap_map.get("provides")
        or cap_map.get("owns")
        or cap_map.get("supports")
        or []
    )
    endpoints = clean.get("endpoints") or []
    endpoint = None
    if isinstance(endpoints, list) and endpoints:
        first = endpoints[0]
        endpoint = first.get("url") if isinstance(first, dict) else str(first)
    elif isinstance(endpoints, str):
        endpoint = endpoints
    summary = str(clean.get("description") or "")
    if len(summary) > AMBIENT_SUMMARY_LIMIT:
        summary = summary[: AMBIENT_SUMMARY_LIMIT - 1].rstrip() + "…"
    return {
        "name": clean.get("name"),
        "summary": summary,
        "provides": caps[:5] if isinstance(caps, list) else [],
        "endpoint": endpoint,
        "status": clean.get("status"),
    }


def _ambient_candidates(prompt: str) -> tuple[list[dict], str]:
    try:
        services = request("GET", "/services")
    except SystemExit:
        return [], "registry_unavailable"
    if not isinstance(services, list):
        return [], "registry_unexpected_response"
    ranked = []
    for service in services:
        if not isinstance(service, dict):
            continue
        score = _score_service(prompt, service)
        if score > 0:
            ranked.append((score, service))
    ranked.sort(key=lambda item: (-item[0], str(item[1].get("name") or "")))
    return [_summarize_service(s) for _score, s in ranked[:AMBIENT_MAX_CANDIDATES]], "registry_ok"


def _ambient_context(event: str, candidates: list[dict], *, registry_state: str) -> str:
    lines = [
        '<asmp-context-shim hidden="true" version="0.1">',
        "Mode: ASMP-aware local service discovery.",
        "",
        "Rules:",
        "- Prefer ASMP registry discovery before hardcoded ports, tools, repos, or service ownership guesses.",
        "- When deterministic routing is ambiguous, cross-role, high-stakes, or low-confidence, ask Eidos Oracle: asmp oracle '<question>'.",
        "- Oracle plans mission contracts; specialists execute; humans approve risky actions.",
        "- Treat manifests as routing metadata, not memory or authority over user intent.",
        "- Never expose secrets, raw manifests, private content, or credential-bearing URLs.",
        "",
        f"Event: {event}",
        f"Registry: {registry_url()} ({registry_state})",
    ]
    if candidates:
        lines.extend(["", "Relevant services:"])
        for svc in candidates:
            bits = [f"- {svc.get('name') or 'unknown'}"]
            if svc.get("summary"):
                bits.append(f": {svc['summary']}")
            if svc.get("provides"):
                bits.append(f" provides={', '.join(map(str, svc['provides'][:3]))}")
            if svc.get("endpoint"):
                bits.append(f" endpoint={svc['endpoint']}")
            lines.append("".join(bits))
    else:
        lines.extend(["", "Relevant services: none selected"])
    if registry_state == "registry_unavailable":
        next_action = "Start or inspect ASMP registry before guessing ports: asmp health"
    elif event == "SessionStart":
        next_action = "When a task needs a local service or owner, run: asmp find --query '<capability or service>'"
    else:
        next_action = "Use the top ASMP candidate only after checking manifest evidence and owner boundary."
    lines.extend(["", "Next best action:", f"- {next_action}", "</asmp-context-shim>"])
    return _redact_text("\n".join(lines))


def _fit_ambient_context(event: str, candidates: list[dict], *, registry_state: str, max_bytes: int) -> tuple[str, list[dict], bool]:
    max_bytes = min(max_bytes, AMBIENT_TOTAL_CAP)
    attempts = [
        candidates,
        [{k: v for k, v in c.items() if k != "endpoint"} for c in candidates],
        [],
    ]
    for candidate_set in attempts:
        context = _ambient_context(event, candidate_set, registry_state=registry_state)
        if len(context.encode()) <= max_bytes:
            return context, candidate_set, True
    return "", [], False


def cmd_ambient(args: argparse.Namespace) -> int:
    event = args.event
    prompt = args.prompt or ""
    disabled, disabled_reason = _ambient_disabled(prompt)
    max_bytes = args.max_bytes or AMBIENT_EVENT_CAPS[event]
    result = {
        "event": event,
        "injected": False,
        "reason": "",
        "mode": "asmp-aware local service discovery",
        "registry": registry_url(),
        "bytes": 0,
        "candidates": [],
        "context": "",
    }
    if disabled:
        result["reason"] = disabled_reason
        emit(result, json_out=args.json)
        return 0
    if event == "UserPromptSubmit" and not _ambient_prompt_matches(prompt):
        result["reason"] = "prompt_not_asmp_relevant"
        emit(result, json_out=args.json)
        return 0
    if event == "SubagentStart" and not (args.parent_used_asmp or _ambient_prompt_matches(args.subagent_scope or prompt)):
        result["reason"] = "subagent_scope_not_asmp_relevant"
        emit(result, json_out=args.json)
        return 0

    candidates: list[dict] = []
    registry_state = "not_queried"
    if event != "SessionStart":
        candidates, registry_state = _ambient_candidates(prompt or args.subagent_scope or "")
    context, fitted_candidates, ok = _fit_ambient_context(
        event,
        candidates,
        registry_state=registry_state,
        max_bytes=max_bytes,
    )
    if not ok:
        result["reason"] = "max_bytes_too_small"
        emit(result, json_out=args.json)
        return 0
    result.update(
        {
            "injected": True,
            "reason": "ok",
            "bytes": len(context.encode()),
            "candidates": fitted_candidates,
            "context": context,
        }
    )
    if args.debug and not args.json:
        print(f"# ASMP Ambient {event}: {result['bytes']} bytes, {len(fitted_candidates)} candidate(s)", file=sys.stderr)
    if args.json:
        emit(result, json_out=True)
    else:
        print(context)
    return 0


def cmd_oracle(args: argparse.Namespace) -> int:
    question = " ".join(args.question).strip()
    contract = _oracle_contract(question, include_registry=not args.no_registry)
    if args.json:
        emit(contract, json_out=True)
        return 0

    print("Eidos Oracle mission contract")
    print(f"intent: {contract['intent']}")
    print(f"should_invoke_oracle: {contract['should_invoke_oracle']} ({', '.join(contract['invoke_reasons'])})")
    print(f"question_type: {contract['question_type']}")
    print(f"registry_state: {contract['registry_state']}")
    print(f"primary_owner: {contract['primary_owner']}")
    if contract["supporting_roles"]:
        print(f"supporting_roles: {', '.join(contract['supporting_roles'])}")
    print("evidence_required:")
    for item in contract["evidence_required"]:
        print(f"  - {item}")
    print("approval_boundaries:")
    for item in contract["approval_boundaries"]:
        print(f"  - {item}")
    return 0


def cmd_health(args: argparse.Namespace) -> int:
    emit(request("GET", "/health"), json_out=args.json)
    return 0


def cmd_host(args: argparse.Namespace) -> int:
    emit(request("GET", "/host"), json_out=args.json)
    return 0


def cmd_hosts(args: argparse.Namespace) -> int:
    """Host discovery — every machine ASMP knows about across the fleet."""
    data = request("GET", "/hosts")
    if args.json:
        emit(data, json_out=True)
        return 0
    hosts = data.get("hosts", [])
    print(f"Hosts ({len(hosts)})  local={data.get('local')}")
    for h in sorted(hosts, key=lambda x: x.get("host", "")):
        mark = "*" if h.get("self") else " "
        note = "  (declared, not yet seen)" if h.get("declared_only") else ""
        print(f"  {mark} {h.get('host',''):24} services={h.get('services',0)}{note}")
    return 0


def cmd_host_history(args: argparse.Namespace) -> int:
    """Durable host roster over time — when each machine was seen and its size."""
    params = {"limit": str(args.limit)}
    if args.host:
        params["host"] = args.host
    data = request("GET", "/hosts/history", params=params)
    if args.json:
        emit(data, json_out=True)
        return 0
    rows = data.get("history", [])
    if not rows:
        print("No host history yet (federation hasn't snapshotted).")
        return 0
    print(f"Host history ({len(rows)} records)")
    for r in rows:
        print(f"  {(r.get('ts') or '')[:19]}  {r.get('host',''):24} services={r.get('services',0)}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    params: dict[str, str] = {}
    if args.section:
        params["section"] = args.section
    if args.query:
        params["q"] = args.query
    if args.healthy:
        params["healthy"] = "true"
    data = request("GET", "/services", params=params or None)
    if args.json:
        emit(data, json_out=True)
        return 0
    if not data:
        print("No services found.")
        return 0
    by_section: dict[str, list] = {}
    for entry in data:
        sec = entry.get("section", "other")
        by_section.setdefault(sec, []).append(entry)
    total = len(data)
    print(f"Services ({total})")
    for sec in sorted(by_section):
        items = by_section[sec]
        print(f"\n{sec.upper()} ({len(items)})")
        for e in sorted(items, key=lambda x: x.get("name", "")):
            healthy = e.get("healthy")
            mark = "✓" if healthy else "✗" if e.get("last_check") else "?"
            name = e.get("name", "?")
            desc = (e.get("description") or "")[:60]
            sync = e.get("sync")
            status = e.get("status")
            tags = [t for t in (sync, status) if t]
            extra = f" [{', '.join(tags)}]" if tags else ""
            print(f"  {mark} {name}: {desc}{extra}")
    return 0


def _discovery_hint(target: str) -> None:
    print(
        f"\nIf '{target}' is real but undocumented, leave a breadcrumb so the gap self-heals\n"
        f"(the next agent's lookup will succeed):\n"
        f"  asmp todo {target} --note \"what it is\" [--repo PATH] [--hint \"how to reach it\"]"
    )


def cmd_get(args: argparse.Namespace) -> int:
    try:
        data = request("GET", f"/services/{args.name}")
    except SystemExit as e:
        msg = str(e)
        print(msg)
        if "404" in msg or "not found" in msg.lower():
            _discovery_hint(args.name)
        return 1
    if args.json:
        emit(data, json_out=True)
        return 0
    print(f"## {data.get('name')}")
    for key in (
        "description",
        "section",
        "healthy",
        "status",
        "sync",
        "source",
        "last_seen",
        "generation",
        "provides",
        "error",
    ):
        if key in data and data[key] is not None:
            val = data[key]
            if isinstance(val, list):
                val = ", ".join(val)
            print(f"  {key}: {val}")
    return 0


def cmd_find(args: argparse.Namespace) -> int:
    if args.capability:
        data = request("GET", "/capabilities", params={"provides": args.capability})
    elif args.query:
        data = request("GET", "/services", params={"q": args.query})
    else:
        raise SystemExit("Provide --capability or --query")
    if args.json:
        emit(data, json_out=True)
        return 0
    if not data:
        target = args.capability or args.query
        print(f"No services match '{target}'.")
        _discovery_hint(target)
        return 1
    print(f"Found {len(data)} service(s)")
    for e in data:
        healthy = e.get("healthy")
        mark = "✓" if healthy else "✗" if e.get("last_check") else "?"
        print(f"\n{mark} {e.get('name')}")
        print(f"  {e.get('description', '')}")
        provides = e.get("provides") or (e.get("capabilities") or {}).get("provides")
        if provides:
            print(f"  provides: {', '.join(provides)}")
        if e.get("source"):
            print(f"  source: {e['source']}")
    return 0


def cmd_caps(args: argparse.Namespace) -> int:
    params = {"provides": args.provides} if args.provides else None
    data = request("GET", "/capabilities", params=params)
    if args.json:
        emit(data, json_out=True)
        return 0
    if args.provides:
        if not data:
            print(f"No services provide '{args.provides}'.")
            _discovery_hint(args.provides)
            return 1
        for e in data:
            print(f"{e.get('name')}: {e.get('description', '')}")
        return 0
    caps = data.get("capabilities", [])
    for cap in caps:
        print(cap)
    return 0


def cmd_scan(args: argparse.Namespace) -> int:
    data = request("POST", "/discover/scan")
    if args.json:
        emit(data, json_out=True)
        return 0
    print("Discovery scan complete")
    for key in ("scanned", "registered", "updated", "skipped", "stale"):
        print(f"  {key}: {data.get(key, 0)}")
    return 0


def cmd_reload(args: argparse.Namespace) -> int:
    data = request("POST", "/reload")
    emit(data, json_out=args.json)
    return 0


def cmd_announce(args: argparse.Namespace) -> int:
    manifest = load_manifest(Path(args.manifest))
    data = request("POST", "/services/announce", body=manifest)
    if args.json:
        emit(data, json_out=True)
        return 0
    print(f"Announced {data.get('name')} (generation {data.get('generation')})")
    print(f"  {data.get('index_url')}")
    return 0


def cmd_register(args: argparse.Namespace) -> int:
    manifest = load_manifest(Path(args.manifest))
    data = request("POST", "/services", body=manifest)
    emit(data, json_out=args.json)
    return 0


def cmd_litmus(args: argparse.Namespace) -> int:
    checks = [
        ("health", lambda: request("GET", "/health")),
        ("host", lambda: request("GET", "/host")),
        ("services", lambda: request("GET", "/services")),
        ("capabilities", lambda: request("GET", "/capabilities")),
        ("email.ingest", lambda: request("GET", "/capabilities", params={"provides": "email.ingest"})),
        ("discover scan", lambda: request("POST", "/discover/scan")),
    ]
    passed = 0
    failed = 0
    print(f"ASMP litmus — {registry_url()}\n")
    for name, fn in checks:
        print(f"→ {name}")
        try:
            result = fn()
            if name == "email.ingest" and not result:
                raise RuntimeError("no matches")
            print("  ✓ PASS")
            passed += 1
        except Exception as e:
            print(f"  ✗ FAIL ({e})")
            failed += 1
    print(f"\nResults: {passed} passed, {failed} failed")
    if args.json:
        print(json.dumps({"passed": passed, "failed": failed}))
    return 1 if failed else 0


def _load_discoveries() -> list:
    if not DISCOVERIES_FILE.exists():
        return []
    out = []
    for line in DISCOVERIES_FILE.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            pass
    return out


def _append_discovery_local(rec: dict) -> None:
    DISCOVERIES_FILE.parent.mkdir(parents=True, exist_ok=True)
    with DISCOVERIES_FILE.open("a") as f:
        f.write(json.dumps(rec) + "\n")


def cmd_todo(args: argparse.Namespace) -> int:
    """Drop a discovery note: an agent/AI system seen in the wild but not yet discoverable in ASMP."""
    body = {
        "name": args.name,
        "note": args.note or "",
        "repo": args.repo or "",
        "hint": args.hint or "",
        "found_by": args.found_by or "agent",
    }
    local_fallback = False
    try:
        rec = request("POST", "/discoveries", body=body)
    except SystemExit:
        local_fallback = True
        rec = {
            **body,
            "discovered_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "status": "todo",
        }
        _append_discovery_local(rec)
    if args.json:
        print(json.dumps(rec, indent=2))
    elif local_fallback:
        print(f"✓ discovery noted locally (registry down): {args.name} ({DISCOVERIES_FILE})")
    else:
        print(
            f"✓ discovery noted: {args.name} — promote it with a manifest + `asmp announce` "
            f"({DISCOVERIES_FILE})"
        )
    return 0


def _print_pending_discoveries(pending: list, *, json_out: bool) -> int:
    if json_out:
        print(json.dumps(pending, indent=2))
        return 0
    if not pending:
        print("No pending discoveries — registry is current.")
        return 0
    print(f"{len(pending)} discovery todo(s) — seen but not yet registered:\n")
    for d in pending:
        print(f"  • {d['name']}  [{d.get('found_by','?')} · {d.get('discovered_at','')[:10]}]")
        if d.get("note"):
            print(f"      {d['note']}")
        if d.get("repo"):
            print(f"      repo: {d['repo']}")
        if d.get("hint"):
            print(f"      hint: {d['hint']}")
    return 0


def cmd_todos(args: argparse.Namespace) -> int:
    """List discovery notes for agents/systems seen but not yet registered."""
    try:
        data = request("GET", "/discoveries", params={"pending": "true"})
        pending = data.get("discoveries", data if isinstance(data, list) else [])
        return _print_pending_discoveries(pending, json_out=args.json)
    except SystemExit:
        discoveries = _load_discoveries()
        registered = set()
        try:
            with urllib.request.urlopen(registry_url() + "/services", timeout=5) as r:
                registered = {s.get("name") for s in json.load(r)}
        except Exception:
            pass
        pending = [d for d in discoveries if d.get("name") not in registered]
        if not args.json:
            print("(registry unreachable — showing local discoveries.jsonl)\n")
        return _print_pending_discoveries(pending, json_out=args.json)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="asmp",
        description="ASMP CLI — local service registry on :7700",
        epilog=(
            "AGENT PROTOCOL: if you discover an agent or AI system that ASMP can't find yet\n"
            "(a real service with no manifest), drop a note so the gap self-heals:\n"
            "  asmp todo <name> --note \"what it is\" [--repo PATH] [--hint \"how to register/reach it\"]\n"
            "A later pass promotes it to a real manifest. See AGENTS.md."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--json", action="store_true", help="Emit JSON")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("health", help="Registry health summary").set_defaults(func=cmd_health)
    sub.add_parser("host", help="Show host profile").set_defaults(func=cmd_host)
    sub.add_parser("hosts", help="Host discovery — all machines in the fleet").set_defaults(func=cmd_hosts)

    hist_p = sub.add_parser("host-history", help="Host roster over time (durable)")
    hist_p.add_argument("--host", help="Filter to one host")
    hist_p.add_argument("--limit", type=int, default=200, help="Max records (default 200)")
    hist_p.set_defaults(func=cmd_host_history)

    list_p = sub.add_parser("list", help="List registered services")
    list_p.add_argument("--section", help="Filter by section")
    list_p.add_argument("--healthy", action="store_true", help="Healthy only")
    list_p.add_argument("-q", "--query", help="Search name/description/capability")
    list_p.set_defaults(func=cmd_list)

    get_p = sub.add_parser("get", help="Get one service")
    get_p.add_argument("name")
    get_p.set_defaults(func=cmd_get)

    find_p = sub.add_parser("find", help="Find services")
    find_p.add_argument("--capability", "-c", help="Capability to match")
    find_p.add_argument("--query", "-q", help="Search query")
    find_p.set_defaults(func=cmd_find)

    caps_p = sub.add_parser("caps", help="List or query capabilities")
    caps_p.add_argument("--provides", help="Filter by capability")
    caps_p.set_defaults(func=cmd_caps)

    sub.add_parser("scan", help="Scan shipped asmp.yaml into index").set_defaults(func=cmd_scan)
    sub.add_parser("reload", help="Reload index from disk").set_defaults(func=cmd_reload)

    ann = sub.add_parser("announce", help="Handshake register from manifest file")
    ann.add_argument("manifest", help="Path to asmp.yaml")
    ann.set_defaults(func=cmd_announce)

    reg = sub.add_parser("register", help="Register from manifest file")
    reg.add_argument("manifest", help="Path to manifest YAML")
    reg.set_defaults(func=cmd_register)

    sub.add_parser("litmus", help="Run gate checks").set_defaults(func=cmd_litmus)

    ambient_p = sub.add_parser(
        "ambient",
        help="Emit a tiny ASMP lifecycle context shim for agent hosts",
        description=(
            "Emit bounded ASMP Ambient context for SessionStart, UserPromptSubmit, or "
            "SubagentStart. The command never emits raw manifests or secrets, respects "
            "ASMP_AMBIENT=off, and injects nothing when prompt relevance is low."
        ),
    )
    ambient_p.add_argument(
        "--event",
        required=True,
        choices=sorted(AMBIENT_EVENT_CAPS),
        help="Lifecycle event to render",
    )
    ambient_p.add_argument("--prompt", default="", help="Current user prompt for relevance/candidate selection")
    ambient_p.add_argument(
        "--parent-used-asmp",
        action="store_true",
        help="For SubagentStart, inject the compact card because the parent task used ASMP",
    )
    ambient_p.add_argument(
        "--subagent-scope",
        default="",
        help="For SubagentStart, scope text used to decide whether ASMP routing applies",
    )
    ambient_p.add_argument(
        "--max-bytes",
        type=int,
        help="Override event byte cap; still bounded by total ASMP cap",
    )
    ambient_p.add_argument("--debug", action="store_true", help="Print redacted local debug summary to stderr")
    ambient_p.set_defaults(func=cmd_ambient)

    oracle_p = sub.add_parser(
        "oracle",
        help="Ask Eidos Oracle for a mission contract",
        description=(
            "Eidos Oracle is the deliberative Eidos product layer powered by ASMP. It turns ambiguous, "
            "cross-role, high-stakes, or low-confidence questions into bounded mission "
            "contracts: owner, supporting roles, evidence, answer format, approval "
            "boundaries, confidence criteria, and routing tests."
        ),
    )
    oracle_p.add_argument("question", nargs="+", help="Question or ask to interpret")
    oracle_p.add_argument(
        "--no-registry",
        action="store_true",
        help="Do not query the local ASMP registry; use only built-in role heuristics",
    )
    oracle_p.set_defaults(func=cmd_oracle)

    todo_p = sub.add_parser("todo", help="Drop a discovery note for an undocumented agent/service")
    todo_p.add_argument("name", help="Name of the agent/service that isn't discoverable yet")
    todo_p.add_argument("--note", help="What it is / what you observed")
    todo_p.add_argument("--repo", help="Repo or path where it lives, if known")
    todo_p.add_argument("--hint", help="How to register or reach it")
    todo_p.add_argument("--found-by", dest="found_by", help="Who found it (agent id / human)")
    todo_p.set_defaults(func=cmd_todo)

    todos_p = sub.add_parser("todos", help="List discovery notes not yet registered")
    todos_p.set_defaults(func=cmd_todos)
    return p


def main(argv: Optional[list[str]] = None) -> int:
    argv = list(argv if argv is not None else sys.argv[1:])
    json_out = "--json" in argv
    if json_out:
        argv = [a for a in argv if a != "--json"]
    parser = build_parser()
    args = parser.parse_args(argv)
    args.json = json_out or getattr(args, "json", False)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
