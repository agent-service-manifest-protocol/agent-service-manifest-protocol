def cmd_litmus(args: argparse.Namespace) -> int:
    checks = [
        ("health", lambda: request("GET", "/health")),
        ("host", lambda: request("GET", "/host")),
        ("services", lambda: request("GET", "/services")),
        ("capabilities", lambda: request("GET", "/capabilities")),
        ("email.ingest", lambda: request("GET", "/capabilities", params={"provides": "email.ingest"})),
        ("discover scan", lambda: request("POST", "/discover/scan")),
    ]
    passed = 0
    failed = 0
    print(f"ASMP litmus — {registry_url()}\n")
    for name, fn in checks:
        print(f"→ {name}")
        try:
            result = fn()
            if name == "email.ingest" and not result:
                raise RuntimeError("no matches")
            print("  ✓ PASS")
            passed += 1
        except Exception as e:
            print(f"  ✗ FAIL ({e})")
            failed += 1
    print(f"\nResults: {passed} passed, {failed} failed")
    if args.json:
        print(json.dumps({"passed": passed, "failed": failed}))
    return 1 if failed else 0


def _load_discoveries() -> list:
    if not DISCOVERIES_FILE.exists():
        return []
    out = []
    for line in DISCOVERIES_FILE.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            pass
    return out


def _append_discovery_local(rec: dict) -> None:
    DISCOVERIES_FILE.parent.mkdir(parents=True, exist_ok=True)
    with DISCOVERIES_FILE.open("a") as f:
        f.write(json.dumps(rec) + "\n")


def cmd_todo(args: argparse.Namespace) -> int:
    """Drop a discovery note: an agent/AI system seen in the wild but not yet discoverable in ASMP."""
    body = {
        "name": args.name,
        "note": args.note or "",
        "repo": args.repo or "",
        "hint": args.hint or "",
        "found_by": args.found_by or "agent",
    }
    local_fallback = False
    try:
        rec = request("POST", "/discoveries", body=body)
    except SystemExit:
        local_fallback = True
        rec = {
            **body,
            "discovered_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "status": "todo",
        }
        _append_discovery_local(rec)
    if args.json:
        print(json.dumps(rec, indent=2))
    elif local_fallback:
        print(f"✓ discovery noted locally (registry down): {args.name} ({DISCOVERIES_FILE})")
    else:
        print(
            f"✓ discovery noted: {args.name} — promote it with a manifest + `asmp announce` "
            f"({DISCOVERIES_FILE})"
        )
    return 0


def _print_pending_discoveries(pending: list, *, json_out: bool) -> int:
    if json_out:
        print(json.dumps(pending, indent=2))
        return 0
    if not pending:
        print("No pending discoveries — registry is current.")
        return 0
    print(f"{len(pending)} discovery todo(s) — seen but not yet registered:\n")
    for d in pending:
        print(f"  • {d['name']}  [{d.get('found_by','?')} · {d.get('discovered_at','')[:10]}]")
        if d.get("note"):
            print(f"      {d['note']}")
        if d.get("repo"):
            print(f"      repo: {d['repo']}")
        if d.get("hint"):
            print(f"      hint: {d['hint']}")
    return 0


def cmd_todos(args: argparse.Namespace) -> int:
    """List discovery notes for agents/systems seen but not yet registered."""
    try:
        data = request("GET", "/discoveries", params={"pending": "true"})
        pending = data.get("discoveries", data if isinstance(data, list) else [])
        return _print_pending_discoveries(pending, json_out=args.json)
    except SystemExit:
        discoveries = _load_discoveries()
        registered = set()
        try:
            with urllib.request.urlopen(registry_url() + "/services", timeout=5) as r:
                registered = {s.get("name") for s in json.load(r)}
        except Exception:
            pass
        pending = [d for d in discoveries if d.get("name") not in registered]
        if not args.json:
            print("(registry unreachable — showing local discoveries.jsonl)\n")
        return _print_pending_discoveries(pending, json_out=args.json)


def _compute_secret_digest(env_var: str) -> Optional[str]:
    """Digest the current env value (never the raw secret) so a manifest can
    carry a verifiable fingerprint of the key it expects."""
    val = os.environ.get(env_var)
    if not val:
        return None
    return "sha256:" + hashlib.sha256(f"{env_var}:{val}".encode()).hexdigest()


def _fmt_price(pricing: dict) -> str:
    inp = pricing.get("input_per_1m")
    outp = pricing.get("output_per_1m")
    tier = pricing.get("tier") or "?"
    if inp is None and outp is None:
        return tier
    return f"{tier} ${inp}/${outp} per 1M"


def _secret_mark(model: dict) -> str:
    if not model.get("secret_required"):
        return "○"
    return "✓" if model.get("secret_verified") else "✗"


def cmd_models_list(args: argparse.Namespace) -> int:
    data = request("GET", "/models")
    if args.json:
        emit(data, json_out=True)
        return 0
    if not data:
        print("No AI models registered.")
        return 0
    print(f"AI Models ({len(data)})")
    for m in sorted(data, key=lambda x: x.get("name", "")):
        mark = _secret_mark(m)
        provides = ", ".join(map(str, (m.get("provides") or [])[:4]))
        print(f"  {mark} {m.get('name')} [{m.get('provider')}]  {_fmt_price(m.get('pricing') or {})}")
        desc = (m.get("description") or "")[:70]
        if desc:
            print(f"      {desc}")
        if provides:
            print(f"      provides: {provides}")
    print("\n  ✓ secret verified   ✗ secret missing/mismatch   ○ no secret required")
    return 0


def cmd_models_recommend(args: argparse.Namespace) -> int:
    params = {"task": args.task}
    if args.budget is not None:
        params["budget"] = str(args.budget)
    data = request("GET", "/models/recommend", params=params)
    if args.json:
        emit(data, json_out=True)
        return 0
    rec = data.get("recommended")
    if not rec:
        within = f" within budget ${args.budget}/1M" if args.budget is not None else ""
        print(f"No verified model matches task '{args.task}'{within}.")
        return 1
    pricing = rec.get("pricing") or {}
    print(f"Recommended for {args.task}: {rec.get('name')} ({rec.get('provider')})")
    print(f"  model_id: {rec.get('model_id')}")
    print(f"  base_url: {rec.get('base_url')}")
    print(f"  pricing:  {_fmt_price(pricing)}")
    others = [m.get("name") for m in data.get("models", [])[1:]]
    if others:
        print(f"  alternatives: {', '.join(others)}")
    return 0


def cmd_models_verify(args: argparse.Namespace) -> int:
    data = request("POST", "/models/verify")
    if args.json:
        emit(data, json_out=True)
        return 0
    print(f"Secret verification: {data.get('verified', 0)}/{data.get('total', 0)} verified")
    for r in data.get("results", []):
        mark = "✓" if r.get("verified") else "✗"
        env = r.get("env_var") or "no secret"
        print(f"  {mark} {r.get('name')}: {r.get('reason')} ({env})")
    return 0


def cmd_models_health(args: argparse.Namespace) -> int:
    data = request("GET", "/models/health")
    if args.json:
        emit(data, json_out=True)
        return 0
    if not data:
        print("No AI models registered.")
        return 0
    healthy = sum(1 for r in data if r.get("healthy"))
    print(f"Model health: {healthy}/{len(data)} reachable")
    for r in data:
        mark = "✓" if r.get("healthy") else "✗"
        detail = r.get("error") or f"HTTP {r.get('status')}"
        print(f"  {mark} {r.get('name')}: {detail}  {r.get('target') or ''}")
    return 0


def cmd_models_register(args: argparse.Namespace) -> int:
    manifest = load_manifest(Path(args.manifest))
    if manifest.get("kind") != "ai-model":
        raise SystemExit(f"Not an ai-model manifest (kind={manifest.get('kind')})")
    secret = manifest.get("secret") or {}
    env_var = secret.get("env_var")
    if env_var:
        digest = _compute_secret_digest(env_var)
        if digest:
            secret["digest"] = digest
            manifest["secret"] = secret
        else:
            print(f"⚠ {env_var} not set — registering without a fresh secret digest", file=sys.stderr)
    data = request("POST", "/services", body=manifest)
    if args.json:
        emit(data, json_out=True)
        return 0
    print(f"✓ registered {data.get('name')} ({manifest.get('model', {}).get('provider')})")
    if env_var and secret.get("digest"):
        print(f"  secret digest for {env_var}: {secret['digest'][:23]}…")
    print(f"  {data.get('path')}")
    return 0


